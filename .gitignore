.env
__pycache__/
*.pyc
*.egg-info/
.idea/
.vscode/

# fresh experiment output (published runs are force-added exceptions to nothing —
# they live in tracked results_*/ and bench/runs/ dirs committed with the repo;
# new local reruns should be added deliberately)
layer1/experiment/live_logs/
layer1/experiment/traffic_logs/

# analyzer plot output (regenerated by --analyze-only runs)
layer1/experiment/l1_results/*
!layer1/experiment/l1_results/.gitkeep
