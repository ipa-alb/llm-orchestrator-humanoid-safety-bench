# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Layer-1 launchers in degradation_test/experiment/NextTest/ load this via
# python-dotenv; the Layer-2 campaign reads the variables from the environment
# (e.g. `set -a; source .env; set +a`).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local models (optional; defaults shown)
#LOCAL_LLM_BASE_URL=http://localhost:11434/v1
#LOCAL_LLM_MODEL=qwen3:8b
